{
  "name": "jarvistype",
  "version": "1.6.6",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend && npm run validate:package",
    "build:backend": "esbuild src/backend.ts --bundle --platform=node --format=esm --target=esnext --outfile=dist/backend.js",
    "build:frontend": "esbuild src/frontend.ts --bundle --platform=browser --format=esm --target=es2022 --outfile=dist/frontend.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "validate:package": "node scripts/validate-package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.25.9",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "lumiverse-spindle-types": "^0.6.46",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.2"
  }
}
